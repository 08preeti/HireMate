# Copy to .env and fill in. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (required)
MONGODB_URI=mongodb://127.0.0.1:27017/hiremate

# Secret used to sign login tokens (required). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Allowed frontend origin(s) for CORS, comma-separated. Leave empty only for local dev.
FRONTEND_URL=http://localhost:3000

# Optional: Twilio SMS for worker OTP. Without these the OTP is returned in the
# API response outside production (dev/demo only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

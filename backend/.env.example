# Required
MONGODB_URI=mongodb://localhost:27017/hiremate
JWT_SECRET=change-me-to-a-long-random-string

# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins. REQUIRED in production (the server refuses to start without it).
# Local default when unset: http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Number of reverse proxies in front of the server (Render = 1). Defaults to 1 in production, 0 otherwise.
# TRUST_PROXY=1

# SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Maps (all optional; the defaults are the free public OpenStreetMap-based services)
# Nominatim requires an identifying contact; set a real address you monitor.
MAP_CONTACT_EMAIL=
NOMINATIM_URL=https://nominatim.openstreetmap.org
PHOTON_URL=https://photon.komoot.io
# Optional but recommended: free key from https://www.geoapify.com (3,000 searches/day, no card).
# Gives much better "type-ahead" suggestions. Leave empty to use only Photon + Nominatim.
GEOAPIFY_API_KEY=https://api.geoapify.com/v1/geocode/search
# The public OSRM demo server is for light use only. Point this at your own OSRM instance in production.
OSRM_URL=https://router.project-osrm.org


# AI assistant (HireMate JARVIS) — optional. Without a key the assistant shows "unavailable"; nothing else changes.
# Keys stay on the server; they are never sent to the browser.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Use a cheaper/faster model for routine turns; raise it if tool orchestration quality is not good enough.
AI_MODEL=claude-haiku-5-5
# AI_TIMEOUT_MS=30000
# AI_MAX_OUTPUT_TOKENS=700

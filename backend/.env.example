# Required
MONGODB_URI=mongodb://localhost:27017/hiremate
JWT_SECRET=change-me-to-a-long-random-string

# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins, e.g. http://localhost:3000
FRONTEND_URL=http://localhost:3000

# SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Maps (all optional; the defaults are the free public OpenStreetMap-based services)
# Nominatim requires an identifying contact; set a real address you monitor.
MAP_CONTACT_EMAIL=
NOMINATIM_URL=https://nominatim.openstreetmap.org
PHOTON_URL=https://photon.komoot.io
# The public OSRM demo server is for light use only. Point this at your own OSRM instance in production.
OSRM_URL=https://router.project-osrm.org
